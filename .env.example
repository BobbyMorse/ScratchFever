# Auth
SECRET_KEY=your-secret-key-here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# Anthropic (used for transcript analysis)
ANTHROPIC_API_KEY=

# Caller settings
CALLER_BASE_URL=http://localhost:8000
CALLER_MAX_CONCURRENT=3
CALLER_CALL_INTERVAL_SEC=4

# Database — set DATABASE_URL in Railway Variables tab (never commit this value)
# Example: postgresql://user:password@host:5432/dbname

# Stripe (web billing) — sandbox keys for dev, live keys for prod
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=
# Optional — override redirect URLs Stripe sends users to
# APP_BASE_URL=https://scratchfrenzy.app
# BILLING_SUCCESS_URL=
# BILLING_CANCEL_URL=
# BILLING_PORTAL_RETURN_URL=

# RevenueCat (mobile billing webhook) — shared secret configured in the RC dashboard
REVENUECAT_WEBHOOK_SECRET=
