# Auth
SECRET_KEY=your-secret-key-here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# Bland AI (active call backend)
BLAND_API_KEY=
BLAND_FROM_NUMBER=
BLAND_VOICE=matt

# Anthropic (used for transcript analysis)
ANTHROPIC_API_KEY=

# Caller settings
CALLER_BASE_URL=http://localhost:8000
CALLER_MAX_CONCURRENT=3
CALLER_CALL_INTERVAL_SEC=4

# Database — set DATABASE_URL in Railway Variables tab (never commit this value)
# Example: postgresql://user:password@host:5432/dbname
